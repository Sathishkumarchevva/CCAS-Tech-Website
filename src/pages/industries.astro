---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import IndustryImage from '../components/IndustryImage.astro';
import { industries } from '../data/site';
---
<Base title="Industries" description="IT consultants who already know your sector: technology, e-commerce, banking, finance, insurance and marketing.">
  <PageHero eyebrow="Industries" title="Consultants who speak your industry's language." lede="Sector experience cuts ramp-up time. We match on the stack and on the compliance, security and delivery habits your industry expects." chips={['Banking', 'Insurance', 'E-commerce', 'Finance']} flip />

  <nav class="subnav" aria-label="Industries">
    <div class="wrap"><ul role="list">{industries.map((i) => <li><a href={`#${i.slug}`}>{i.title}</a></li>)}</ul></div>
  </nav>

  <section class="section">
    <div class="wrap list">
      {industries.map((ind, i) => (
        <article class:list={['ind', { flip: i % 2 === 1 }]} id={ind.slug}>
          <div class="img reveal" data-r={i % 2 ? 'right' : 'left'}>
            <div class="img-in" data-parallax="0.07" data-zoom="1.14"><IndustryImage name={ind.image} alt="" sizes="(min-width: 900px) 640px, 100vw" width={1200} /></div>
            <span class="big-n" aria-hidden="true">0{i + 1}</span>
          </div>
          <div class="txt">
            <span class="label eyebrow reveal">Industry 0{i + 1}</span>
            <h2 data-split>{ind.title}</h2>
            <p class="lede reveal" style="--d:.15s">{ind.detail}</p>
            <p class="label reveal" style="margin-top:28px;--d:.2s">Roles we place most</p>
            <ul class="tags reveal" style="margin-top:12px;--d:.25s">{ind.roles.map((r) => <li>{r}</li>)}</ul>
            <p class="reveal" style="margin-top:32px;--d:.3s"><a class="arrow-link" href="/contact/">Talk to a {ind.title.toLowerCase()} specialist <Icon name="ArrowRight" size={18} /></a></p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand title="Don't see your industry?" text="We staff across sectors. Tell us about your team and we'll tell you honestly whether we're the right fit." />
</Base>

<style>
  .subnav { position: sticky; top: var(--header-h); z-index: 20; background: rgba(255,255,255,.94); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
  .subnav ul { display: flex; gap: 8px; padding: 12px 0; overflow-x: auto; scrollbar-width: none; }
  .subnav a { display: block; padding: 8px 16px; border-radius: 999px; font-weight: 600; font-size: 15px; color: var(--navy); text-decoration: none; white-space: nowrap; transition: background-color .2s, color .2s; }
  .subnav a:hover { background: var(--navy); color: #fff; }
  .list { display: grid; gap: clamp(72px, 10vw, 140px); }
  .ind { display: grid; gap: 40px; align-items: center; scroll-margin-top: calc(var(--header-h) + 80px); }
  .img { position: relative; border-radius: var(--radius-card); overflow: hidden; aspect-ratio: 4 / 3; background: var(--navy); }
  .img-in { position: absolute; inset: 0; }
  .img-in :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(11,31,58,.7)); pointer-events: none; }
  .big-n { position: absolute; z-index: 1; left: 24px; bottom: 8px; font-family: var(--font-display); font-weight: 700; font-size: clamp(72px, 9vw, 128px); line-height: 1; color: transparent; -webkit-text-stroke: 2px rgba(255,255,255,.85); pointer-events: none; }
  .txt h2 { margin: 16px 0 20px; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.08; letter-spacing: -.02em; }
  @media (min-width: 900px) {
    .ind { grid-template-columns: 1.1fr 1fr; gap: 88px; }
    .ind.flip { grid-template-columns: 1fr 1.1fr; }
    .ind.flip .img { order: 2; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import IndustryImage from '../components/IndustryImage.astro';
import { industries } from '../data/site';
---
<Base title="Industries" description="IT consultants who already know your sector: technology, e-commerce, banking, finance, insurance and marketing.">
  <PageHero eyebrow="Industries" title="Consultants who already speak your industry's language." lede="Sector experience cuts ramp-up time. We match on the stack and on the compliance, security and delivery habits your industry expects." />

  <section class="section">
    <div class="wrap list">
      {industries.map((ind, i) => (
        <article class:list={['ind', { flip: i % 2 === 1 }]} id={ind.slug}>
          <div class="img reveal"><IndustryImage name={ind.image} alt="" sizes="(min-width: 900px) 560px, 100vw" width={1200} /></div>
          <div class="txt reveal">
            <span class="label eyebrow">0{i + 1}</span>
            <h2>{ind.title}</h2>
            <p class="lede">{ind.detail}</p>
            <p class="label" style="margin-top:24px">Roles we place most</p>
            <ul class="tags" style="margin-top:12px">{ind.roles.map((r) => <li>{r}</li>)}</ul>
            <p style="margin-top:32px"><a class="arrow-link" href={`/contact/`}>Talk to a {ind.title.toLowerCase()} specialist <Icon name="ArrowRight" size={18} /></a></p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand title="Don't see your industry?" text="We staff across sectors. Tell us about your team and we'll tell you honestly whether we're the right fit." />
</Base>

<style>
  .list { display: grid; gap: clamp(56px, 8vw, 104px); }
  .ind { display: grid; gap: 32px; align-items: center; scroll-margin-top: calc(var(--header-h) + 24px); }
  .img { border-radius: var(--radius-card); overflow: hidden; aspect-ratio: 4 / 3; background: var(--navy); }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .txt h2 { margin: 16px 0 16px; }
  @media (min-width: 900px) {
    .ind { grid-template-columns: 1fr 1fr; gap: 72px; }
    .ind.flip .img { order: 2; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import HeroPledge from '../components/HeroPledge.astro';
import { values, commitments, site, industries, mission, approach, anySize } from '../data/site';
---
<Base title="About" description="We connect businesses with highly skilled technology consultants, on contract, contract-to-hire or direct hire.">
  <PageHero eyebrow="About CCAS Tech" title="The right expert, connected to the right team." lede="Great technology needs the right people behind it. CCAS Tech is a USA-based IT consulting and staffing company, and we connect businesses with highly skilled technology consultants."><HeroPledge slot="art" /></PageHero>

  <section class="section statement">
    <div class="wrap">
      <span class="label eyebrow reveal">What we do</span>
      <p class="scrub" data-scrub>Technology only delivers when the right people are behind it. So we start by understanding the work, match consultants who have done it before, agree clear contracts up front and <em>stay close once the engagement starts.</em></p>
    </div>
  </section>



  <section class="glance" aria-label="CCAS Tech at a glance">
    <div class="wrap">
      <dl>
        <div class="reveal"><dt class="label">Founded</dt><dd>{site.founded}</dd></div>
        <div class="reveal" style="--d:.08s"><dt class="label">Team</dt><dd>{site.teamSize.min}&ndash;{site.teamSize.max} people</dd></div>
        <div class="reveal" style="--d:.16s"><dt class="label">Based in</dt><dd>{site.city}, {site.regionCode}</dd></div>
        <div class="reveal" style="--d:.24s"><dt class="label">Industries</dt><dd>{industries.length} sectors</dd></div>
      </dl>
    </div>
  </section>

  <!-- MISSION & VISION -->
  <section class="section section--mist">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">Why we exist</span><h2 data-split>Built to do hiring differently.</h2></div>
        <p class="lede reveal">Technology staffing can feel confusing and repetitive. We set out to make it clear: honest advice, written terms and someone who follows through.</p>
      </div>
      <div class="grid grid--2 mv">
        <article class="card card--accent spot reveal" data-r="left"><h3>Our mission</h3><p>{mission.mission}</p></article>
        <article class="card card--accent spot reveal" data-r="right"><h3>Our vision</h3><p>{mission.vision}</p></article>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">Our approach</span><h2 data-split>Hands-on, accountable, measurable.</h2></div>
        <p class="lede reveal">We learn your technical and cultural environment first, so every recommendation fits how your team really works.</p>
      </div>
      <div class="grid grid--3">
        {approach.map((a, i) => (
          <article class="card spot reveal" data-r="up-lg" style={`--d:${i * 0.1}s`}>
            <span class="icon-tile icon-tile--navy"><Icon name={a.icon} /></span>
            <h3>{a.title}</h3>
            <p>{a.blurb}</p>
          </article>
        ))}
      </div>
      <p class="size reveal">{anySize}</p>
      <p class="reveal" style="margin-top:28px"><a class="arrow-link" href="/expertise/">See what we do <Icon name="ArrowRight" size={18} /></a> &nbsp;·&nbsp; <a class="arrow-link" href="/industries/">Industries we serve <Icon name="ArrowRight" size={18} /></a></p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">How we behave</span><h2 data-split>Expert. Reliable. Connected. Direct.</h2></div>
        <p class="lede reveal">Four habits that shape every conversation, every shortlist and every contract.</p>
      </div>
      <div class="grid grid--4">
        {values.map((v, i) => (
          <article class="card spot reveal" data-r="up-lg" style={`--d:${i * 0.08}s`}>
            <span class="icon-tile icon-tile--navy"><Icon name={v.icon} /></span>
            <h3 class="h4">{v.title}</h3>
            <p>{v.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap mark-grid">
      <div class="mark-art reveal" data-r="left">
        <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
          <g class="ring r1"><circle cx="200" cy="200" r="150" fill="none" stroke="#0B1F3A" stroke-opacity=".14" stroke-width="1.5" stroke-dasharray="3 9" /><circle cx="350" cy="200" r="7" fill="#FF7A1A" /></g>
          <g class="ring r2"><circle cx="200" cy="200" r="185" fill="none" stroke="#0B1F3A" stroke-opacity=".1" stroke-width="1.5" /><circle cx="200" cy="15" r="5" fill="#0B1F3A" /></g>
        </svg>
        <img src="/images/ccas-tech-mark-color.svg" alt="" width="240" height="240" loading="lazy" />
      </div>
      <div>
        <span class="label eyebrow reveal">Our mark</span>
        <h2 data-split style="margin-top:16px">Two arcs, one match.</h2>
        <p class="lede reveal" style="margin-top:24px;--d:.2s">Two nested arcs form a double C — client and consultant — opening toward a single orange point: the right match. It is the idea behind everything we do.</p>
      </div>
    </div>
  </section>

  <section class="section section--navy dark numbers" data-glow>
    <div class="aurora" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <p class="label eyebrow reveal" style="margin:0 auto 48px">Our commitments</p>
      <div class="stats">
        {commitments.map((s) => <div class="stat reveal" data-r="up-lg"><b>{s.word}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </section>

  <CtaBand title="Enough about us. It is about you." text="Tell us what you need and decide for yourself if we are the right IT partner." />
</Base>

<style>
  .size { margin-top: 40px; max-width: 760px; font-size: clamp(18px, 1.8vw, 22px); color: var(--slate); font-family: var(--font-display); line-height: 1.45; }
  .mv .card h3 { margin-bottom: 12px; }
  .mv .card p { font-size: 18px; line-height: 1.6; color: var(--slate); }
  .deliver .card { display: flex; flex-direction: column; gap: 16px; }
  .deliver .card :global(.arrow-link) { margin-top: auto; }
  .deliver .tags { margin: 4px 0 8px; }
  .section--navy { overflow: hidden; isolation: isolate; }
  .glance { border-block: 1px solid var(--border); background: #fff; }
  .glance dl { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; }
  .glance dl > div { padding: 28px 16px; border-bottom: 1px solid var(--border); }
  .glance dl > div:nth-child(odd) { border-right: 1px solid var(--border); }
  .glance dl > div:nth-last-child(-n+2) { border-bottom: 0; }
  .glance dt { margin-bottom: 6px; }
  .glance dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 2.6vw, 36px); letter-spacing: -.02em; color: var(--navy); line-height: 1.1; }
  @media (min-width: 800px) { .glance dl { grid-template-columns: repeat(4, 1fr); } .glance dl > div { padding: 36px 28px; border-bottom: 0; } .glance dl > div:nth-child(odd) { border-right: 0; } .glance dl > div + div { border-left: 1px solid var(--border); } .glance dl > div:first-child { padding-left: 0; } }
  .statement { padding-block: clamp(80px, 11vw, 160px); }
  .statement .scrub { margin-top: 28px; max-width: 24em; }
  .mark-grid { display: grid; gap: 48px; align-items: center; }
  .mark-art { position: relative; background: var(--mist); border: 1px solid var(--border); border-radius: var(--radius-card); display: grid; place-items: center; aspect-ratio: 1; max-width: 520px; width: 100%; overflow: hidden; }
  .mark-art svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .mark-art img { position: relative; width: 42%; height: auto; animation: breathe 6s ease-in-out infinite; }
  .ring { transform-box: view-box; transform-origin: 50% 50%; animation: spin 50s linear infinite; }
  .ring.r2 { animation-duration: 80s; animation-direction: reverse; }
  @media (min-width: 900px) { .mark-grid { grid-template-columns: 1fr 1fr; gap: 96px; } }
  .numbers { overflow: hidden; isolation: isolate; padding-block: clamp(72px, 9vw, 120px); }
  .stats { display: grid; gap: 40px 0; grid-template-columns: repeat(3, 1fr); text-align: center; }
  .stat { padding-inline: 16px; }
  @media (min-width: 720px) { .stat + .stat { border-left: 1px solid var(--on-navy-line); } }
  @media (max-width: 719px) { .stats { grid-template-columns: 1fr; } .stat + .stat { padding-top: 40px; border-top: 1px solid var(--on-navy-line); } }
  .stat b { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(48px, 7vw, 96px); line-height: 1; letter-spacing: -.03em; color: #fff; }
  .stat span { display: block; margin-top: 12px; color: var(--on-navy); font-size: 18px; }
  @media (prefers-reduced-motion: reduce) { .mark-art img, .ring { animation: none; } }
</style>

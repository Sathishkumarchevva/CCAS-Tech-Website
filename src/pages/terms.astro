---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Terms of use" description="Terms for using the CCAS Tech website.">
  <section class="section">
    <div class="wrap prose">
      <span class="label eyebrow">Legal</span>
      <h1 style="margin:16px 0 8px">Terms of use</h1>
      <p class="small">Last updated: 2026. <strong>Draft for legal review before launch.</strong></p>

      <h2>Using this website</h2>
      <p>This website provides information about CCAS Tech's IT consulting and staffing services. By using it you agree to these terms. Please do not use the website unlawfully or in a way that could damage or disrupt it.</p>
      <h2>No offer or guarantee</h2>
      <p>Information here is general and may change. Nothing on this website is an offer of employment or a guarantee of placement, availability or results. Services are provided under separate written agreements.</p>
      <h2>Intellectual property</h2>
      <p>The CCAS Tech name, logo and website content belong to CCAS Tech. Please do not copy or reuse them without written permission.</p>
      <h2>Third-party links</h2>
      <p>We are not responsible for the content or practices of websites we link to.</p>
      <h2>Liability</h2>
      <p>To the extent the law allows, CCAS Tech is not liable for losses arising from use of this website.</p>
      <h2>Contact</h2>
      <p>Questions? Write to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { values, stats } from '../data/site';
---
<Base title="About" description="CCAS Tech is a USA-based IT consulting and staffing company that connects businesses with highly skilled technology consultants.">
  <PageHero eyebrow="About CCAS Tech" title="The right expert, connected to the right team." lede="CCAS Tech is a USA-based IT consulting and staffing company that connects businesses with highly skilled technology consultants." />

  <section class="section">
    <div class="wrap story">
      <div>
        <span class="label eyebrow">What we do</span>
        <h2 style="margin-top:16px">We know the work we staff.</h2>
      </div>
      <div class="body">
        <p class="lede">Hiring technical people is hard to do well. The résumé says one thing, the project needs another, and a wrong placement costs months.</p>
        <p class="lede">We start by understanding the work. Then we match consultants who have done it before, agree clear contracts, and stay close once the engagement starts. We place people who build with quality and precision, and we stand behind every placement.</p>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">How we behave</span><h2>Expert. Reliable. Connected. Direct.</h2></div>
        <p class="lede">Four habits that shape every conversation, every shortlist and every contract.</p>
      </div>
      <div class="grid grid--4">
        {values.map((v) => (
          <article class="card reveal">
            <span class="icon-tile icon-tile--navy"><Icon name={v.icon} /></span>
            <h3 class="h4">{v.title}</h3>
            <p>{v.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap mark-grid">
      <div class="mark-art"><img src="/images/ccas-tech-mark-color.svg" alt="" width="240" height="240" loading="lazy" /></div>
      <div>
        <span class="label eyebrow">Our mark</span>
        <h2 style="margin-top:16px">Two arcs, one match.</h2>
        <p class="lede" style="margin-top:24px">Two nested arcs form a double C — client and consultant — opening toward a single orange point: the right match. It is the idea behind everything we do.</p>
      </div>
    </div>
  </section>

  <section class="section section--navy dark" style="padding-block:clamp(56px,7vw,88px)">
    <div class="wrap stats">
      {stats.map((s) => <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>)}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; gap: 32px; }
  .body { display: grid; gap: 20px; max-width: 640px; }
  @media (min-width: 900px) { .story { grid-template-columns: 1fr 1.2fr; gap: 72px; } }
  .mark-grid { display: grid; gap: 40px; align-items: center; }
  .mark-art { background: var(--mist); border-radius: var(--radius-card); display: grid; place-items: center; aspect-ratio: 4/3; }
  .mark-art img { width: min(46%, 220px); height: auto; }
  @media (min-width: 900px) { .mark-grid { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  .stats { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  .stat b { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(40px, 5vw, 64px); line-height: 1.1; letter-spacing: -.02em; color: #fff; }
  .stat span { color: var(--on-navy); }
</style>

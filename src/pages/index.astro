---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import IndustryImage from '../components/IndustryImage.astro';
import Steps from '../components/Steps.astro';
import TechMarquee from '../components/TechMarquee.astro';
import { roles, management, industries, steps, values, commitments, fixes, solutions, site } from '../data/site';
---
<Base title="IT consulting & staffing" description="CCAS Tech connects businesses with highly skilled IT consultants — cloud, data, cybersecurity and software delivery. The right expert, connected to the right team.">

  <!-- HERO -->
  <section class="hero dark" data-glow>
    <canvas class="stars" data-stars aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"><i></i><i></i></div>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="copy">
        <h1 class="display" data-split>Great technology needs the <em>right people behind it.</em></h1>
        <p class="lede reveal" style="--d:.45s">We connect businesses with vetted consultants across cloud, data, security and software, on contract, contract-to-hire or direct hire.</p>
        <div class="ctas reveal" style="--d:.6s">
          <a class="btn btn--primary" href="/contact-us/">Find a consultant <Icon name="ArrowRight" size={20} /></a>
          <a class="btn btn--outline" href="/careers/">Join our network</a>
        </div>
        <ul class="chips reveal" role="list" aria-label="Skills we place" style="--d:.75s">
          {['Full-stack', 'Cloud & DevOps', 'Data & AI', 'QA automation', 'Cybersecurity', 'Contact center'].map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div class="stage" data-hero3d>
        <img class="fallback" src="/images/ccas-tech-mark-reversed.svg" alt="" width="320" height="320" fetchpriority="high" />
        <canvas aria-hidden="true"></canvas>
        <span class="float f1"><i></i>Pre-vetted engineers</span>
        <span class="float f2"><i class="w"></i>Cloud · Data · Security</span>
      </div>
    </div>
  </section>


  <!-- WHAT WE DO -->
  <section class="section" id="what">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">Introducing CCAS Tech</span><h2>Your big IT plans, without the hassle.</h2></div>
        <p class="lede">Technology moves fast, and there is rarely time to research every option or risk an amateur. We bring structured, accountable IT support you can trust, in four forms.</p>
      </div>
      <div class="grid grid--4 sol">
        {solutions.map((x, i) => (
          <article class="card spot reveal" data-r="up-lg" style={`--d:${i * 0.08}s`}>
            <span class="icon-tile icon-tile--navy"><Icon name={x.icon} /></span>
            <h3 class="h4">{x.title}</h3>
            <p>{x.blurb}</p>
            <a class="arrow-link" href={`/expertise/${x.href}`}>{x.cta} <Icon name="ArrowRight" size={18} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--mist" id="services">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">IT recruiting &amp; staffing</span><h2>Technology talent, ready to ship.</h2></div>
        <p class="lede">Cloud, security, data, AI and software specialists, vetted for depth and ready to contribute from the first week.</p>
      </div>
      <ul class="role-grid" role="list">
        {roles.map((r, i) => (
          <li class="reveal" style={`--d:${(i % 4) * 0.05}s`}>
            <a class="role spot" href={`/expertise/#${r.slug}`}>
              <span class="icon-tile"><Icon name={r.icon} /></span>
              <h3>{r.title}</h3>
              <p>{r.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a class="arrow-link" href="/expertise/">See all expertise <Icon name="ArrowRight" size={20} /></a></p>
    </div>
  </section>

  <TechMarquee />

  <!-- WHERE HIRING GOES WRONG -->
  <section class="section" id="why">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">Why we are different</span><h2>Hiring technical people goes wrong in three ways.</h2></div>
        <p class="lede">We built CCAS Tech around fixing each one, and we say so in the contract.</p>
      </div>
      <div class="grid grid--3 fixes">
        {fixes.map((x, i) => (
          <article class="card spot reveal" data-r="up-lg" style={`--d:${i * 0.1}s`}>
            <p class="label bad">{x.problem}</p>
            <h3>{x.title}</h3>
            <p>{x.fix}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section section--mist" id="how">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">How it works</span><h2>From brief to first day, without the runaround.</h2></div>
        <p class="lede">We keep the process short and the language plain, so you always know what happens next.</p>
      </div>
      <Steps items={steps} />
    </div>
  </section>

  <!-- MANAGEMENT -->
  <section class="section section--navy dark" id="management">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">Leadership</span><h2>Leaders for the work around the code.</h2></div>
        <p class="lede">Experienced managers for interim or project work, accountable for the result and not only the plan.</p>
      </div>
      <div class="grid grid--4">
        {management.map((m, i) => (
          <article class="card card--dark spot reveal" style={`--d:${i * 0.08}s`} data-r="up-lg">
            <span class="icon-tile"><Icon name={m.icon} /></span>
            <h3 class="h4">{m.title}</h3>
            <p>{m.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section" id="industries">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><span class="label eyebrow">Industries</span><h2>Specialists who already speak your industry's language.</h2></div>
        <p class="lede">Sector experience cuts ramp-up time. Before we send anyone, we find out what your industry expects on security and compliance.</p>
      </div>
      <ul class="ind-grid" role="list">
        {industries.map((ind, i) => (
          <li class="reveal" style={`--d:${(i % 3) * 0.06}s`}>
            <a class="tile" href={`/industries/#${ind.slug}`}>
              <IndustryImage name={ind.image} alt="" />
              <span class="cap"><span class="cap-t">{ind.title} <Icon name="ArrowRight" size={20} /></span><span class="cap-b">{ind.blurb}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="section section--mist" id="about">
    <div class="wrap">
      <div class="about-grid">
        <div>
          <span class="label eyebrow">About CCAS Tech</span>
          <h2>The right expert, connected to the right team.</h2>
          <p class="lede" style="margin-top:24px">Founded in 2020, we start by understanding the work. Then we match consultants who have done it before, agree clear contracts up front, and stay close once the engagement starts. Plain language, no surprises.</p>
          <p style="margin-top:32px"><a class="btn btn--secondary" href="/about-us/">About us <Icon name="ArrowRight" size={20} /></a></p>
        </div>
        <ul class="values" role="list">
          {values.map((v) => (
            <li class="card spot reveal" data-r="right">
              <span class="icon-tile icon-tile--navy"><Icon name={v.icon} /></span>
              <div><h3 class="h4">{v.title}</h3><p>{v.blurb}</p></div>
            </li>
          ))}
        </ul>
      </div>

      <div class="stats dark reveal" data-r="scale">
        <h3>Ready to talk about your team?<br /><em>We will take it from there.</em></h3>
        {commitments.map((s) => <div class="stat"><b>{s.word}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </section>

  <!-- TWO WAYS IN -->
  <section class="section" id="ways">
    <div class="wrap">
      <div class="sec-head"><div><span class="label eyebrow">Two ways in</span><h2 data-split>Hiring, or looking for your next role?</h2></div></div>
      <div class="grid grid--2 ways">
        <article class="card card--accent spot reveal" data-r="left">
          <span class="icon-tile icon-tile--navy"><Icon name="Building" /></span>
          <h3>For businesses</h3>
          <p>Tell us the role, the stack and the timeline. You get a short list of vetted consultants, with rates and terms agreed before anyone starts.</p>
          <a class="btn btn--primary" href="/contact-us/">Find a consultant <Icon name="ArrowRight" size={20} /></a>
        </article>
        <article class="card card--accent spot reveal" data-r="right">
          <span class="icon-tile icon-tile--navy"><Icon name="UserCheck" /></span>
          <h3>For technology professionals</h3>
          <p>Share what you do best. We match you to roles that fit your skills, put the contract in writing, and a recruiter stays in touch.</p>
          <a class="btn btn--secondary" href="/careers/">Join our network <Icon name="ArrowRight" size={20} /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section--navy dark" id="contact">
    <div class="wrap contact-grid">
      <div>
        <span class="label eyebrow">Get started</span>
        <h2>Tell us what you need.</h2>
        <p class="lede" style="margin-top:24px">Share the role, the stack and the timeline. We will reply with a plan and a short list of vetted consultants.</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <ContactForm theme="dark" id="home-form" />
    </div>
  </section>
</Base>

<script>
  import '../scripts/hero3d';
</script>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; background: var(--navy); }
  .hero .display { font-size: clamp(42px, 6vw, 84px); line-height: 1.04; letter-spacing: -0.03em; }
  .stars { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .hero-grid { display: grid; gap: 32px; align-items: center; min-height: min(calc(100svh - var(--header-h) - 96px), 760px); padding-block: 48px 64px; }
  .hero .display { margin-top: 0; color: #fff; }
  .hero .display em { font-style: normal; color: var(--orange); }
  .hero .lede { margin-top: 24px; max-width: 540px; color: var(--on-navy); }
  .ctas { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 16px; }
  .chips { margin-top: 48px; display: flex; flex-wrap: wrap; gap: 8px; max-width: 560px; padding: 0; }
  .chips li { padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.07); border: 1px solid var(--on-navy-line); font-size: 14px; line-height: 20px; color: #DDE4F0; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 24px; } }

  .stage { position: relative; height: clamp(320px, 52vw, 700px); border-radius: 28px; }
  .stage::before { content: ""; position: absolute; left: 50%; top: 50%; width: 80%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(255,122,26,.16), transparent 65%); animation: glow 4s ease-in-out infinite; }
  @keyframes glow { 50% { opacity: .45; transform: translate(-50%, -50%) scale(1.12); } }
  .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage .fallback { position: absolute; inset: 0; margin: auto; width: min(46%, 240px); height: auto; transition: opacity .6s; }
  .stage.is-ready .fallback { opacity: 0; }
  .float { position: absolute; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 999px; background: rgba(19,41,77,.72); border: 1px solid var(--on-navy-line); backdrop-filter: blur(10px); font-size: 14px; font-weight: 600; color: #fff; white-space: nowrap; animation: floaty 5s ease-in-out infinite; pointer-events: none; }
  .float i { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgba(255,122,26,.2); }
  .float i.w { background: #fff; box-shadow: 0 0 0 4px rgba(255,255,255,.15); }
  .f1 { top: 20px; left: 8px; } .f2 { bottom: 40px; right: 8px; animation-delay: 1.2s; }
  @keyframes floaty { 50% { transform: translateY(-6px); } }
  @media (max-width: 639px) { .float { display: none; } .stage { height: 300px; } }


  /* Services grid */
  .sol .card { display: flex; flex-direction: column; gap: 12px; }
  .sol .card .arrow-link { margin-top: auto; padding-top: 8px; align-self: flex-start; }
  .fixes .card { display: flex; flex-direction: column; gap: 12px; padding: 32px; }
  .fixes .bad { color: #B42318; display: flex; align-items: center; gap: 10px; }
  .fixes .bad::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #B42318; }
  .fixes h3 { font-size: clamp(22px, 2vw, 26px); margin: 0; }
  .fixes p:last-child { color: var(--steel); margin: 0; }
  .role-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); padding: 0; }
  .role { display: block; height: 100%; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card); padding: 28px; text-decoration: none; transition: border-color .25s, transform .25s, box-shadow .25s; }
  .role:hover { border-color: var(--navy); transform: translateY(-4px); box-shadow: 0 18px 40px -22px rgba(11,31,58,.35); }
  .role h3 { margin-bottom: 8px; }
  .role p { color: var(--steel); font-size: 15px; line-height: 24px; margin: 0; }
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 640px) {
      .role-grid > li { display: grid; grid-template-rows: subgrid; grid-row: span 3; }
      .role { display: grid; grid-template-rows: subgrid; grid-row: span 3; row-gap: 0; align-content: start; }
    }
  }
  @media (max-width: 639px) {
    .role-grid { gap: 12px; }
    .role { display: grid; grid-template-columns: 48px 1fr; column-gap: 16px; padding: 18px 20px; align-items: start; }
    .role :global(.icon-tile) { grid-row: 1 / span 2; margin: 0; }
    .role h3 { align-self: end; margin-bottom: 4px; }
    .role p { grid-column: 2; }
  }
  .role:hover .icon-tile { background: var(--navy); color: #fff; }
  .more { margin-top: 40px; }


  /* Industries */
  .ind-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); padding: 0; }
  .tile { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: var(--radius-card); overflow: hidden; color: #fff; text-decoration: none; background: var(--navy); }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .tile:hover :global(img) { transform: scale(1.05); }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(11,31,58,.94)); }
  .cap { position: absolute; z-index: 1; left: 24px; right: 24px; bottom: 20px; display: grid; gap: 6px; }
  .cap-t { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; font-size: 24px; }
  .cap-b { font-size: 15px; line-height: 22px; color: #DDE4F0; max-height: 0; opacity: 0; overflow: hidden; transition: max-height .45s cubic-bezier(.2,.8,.2,1), opacity .35s; }
  .tile:hover .cap-b, .tile:focus-visible .cap-b { max-height: 70px; opacity: 1; }
  @media (hover: none) { .cap-b { max-height: 70px; opacity: 1; } }
  .cap :global(svg) { transition: transform .2s; }
  .tile:hover .cap :global(svg) { transform: translateX(4px); color: var(--orange); }

  /* About */
  .about-grid { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 900px) { .about-grid > div:first-child { position: sticky; top: calc(var(--header-h) + 32px); } }
  .values { display: grid; gap: 16px; padding: 0; grid-template-columns: 1fr; }
  .values .card { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding: 24px; align-items: start; }
  .values .icon-tile { margin: 0; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 1fr 1fr; gap: 64px; } }

  .stats .stat b { font-size: clamp(28px, 3.2vw, 44px); }
  .stats { margin-top: clamp(48px, 7vw, 96px); display: grid; gap: 24px; padding: clamp(28px, 4vw, 48px); border-radius: 24px; background: var(--navy); grid-template-columns: 1fr 1fr; align-items: center; }
  .stats h3 { grid-column: 1 / -1; color: #fff; font-weight: 700; }
  .stats h3 em { font-style: normal; color: var(--orange); }
  .stat b { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(34px, 4vw, 52px); line-height: 1.1; letter-spacing: -.02em; color: #fff; }
  .stat span { font-size: 14px; color: var(--on-navy); }
  @media (min-width: 900px) { .stats { grid-template-columns: 1.4fr repeat(3, 1fr); } .stats h3 { grid-column: auto; } }

  /* Contact */
  .ways .card { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: clamp(28px, 3vw, 44px); }
  .ways .card .btn { margin-top: auto; }
  .ways h3 { font-size: clamp(24px, 2.4vw, 32px); }
  @supports (grid-template-rows: subgrid) { @media (min-width: 640px) { .ways .card { display: grid; grid-template-rows: subgrid; grid-row: span 4; row-gap: 16px; justify-items: start; } .ways .card h3, .ways .card p { margin: 0; } } }
  .contact-grid { display: grid; gap: 48px; }
  .mail { display: inline-block; margin-top: 32px; font-family: var(--font-display); font-weight: 500; font-size: clamp(20px, 2.4vw, 26px); color: #fff; text-decoration: none; border-bottom: 2px solid var(--orange); padding-bottom: 4px; }
  .mail:hover { color: var(--orange); }
  @media (min-width: 960px) { .contact-grid { grid-template-columns: 1fr 1.15fr; gap: 64px; } }
</style>

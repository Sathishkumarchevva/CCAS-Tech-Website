---
interface Props { eyebrow: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<section class="page-hero dark" data-glow>
  <canvas class="stars" data-stars aria-hidden="true"></canvas>
  <div class="aurora" aria-hidden="true"><i></i><i></i></div>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="wrap ph-grid">
    <div class="copy">
      <span class="label eyebrow reveal">{eyebrow}</span>
      <h1 data-split>{title}</h1>
      {lede && <p class="lede reveal" style="--d:.3s">{lede}</p>}
      <div class="actions reveal" style="--d:.42s"><slot /></div>
    </div>
    <div class="art-wrap reveal" data-r="scale" style="--d:.2s"><div class="art"><slot name="art" /></div></div>
  </div>
</section>
<style>
  .ph-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .ph-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; } }
  .page-hero { padding-block: clamp(56px, 8vw, 120px); }
  .page-hero :global(.lede) { font-size: clamp(18px, 1.7vw, 22px); }
  .art-wrap { width: min(100%, 560px); margin-inline: auto; }
  .art { position: relative; width: 100%; aspect-ratio: 1; container-type: inline-size; }
</style>

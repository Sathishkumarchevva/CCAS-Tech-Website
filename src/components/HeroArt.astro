---
// Decorative hero artwork for inner pages: orbit rings around the supplied mark. Pure CSS animation.
interface Props { chips?: string[]; flip?: boolean; }
const { chips = [], flip = false } = Astro.props;
const pos = [
  { top: '6%', left: '2%' }, { top: '24%', right: '-2%' }, { bottom: '22%', left: '-4%' }, { bottom: '4%', right: '10%' },
];
const nodes = (r: number, n: number, off = 0) => Array.from({ length: n }, (_, i) => {
  const a = off + (i / n) * Math.PI * 2; return { x: 260 + Math.cos(a) * r, y: 260 + Math.sin(a) * r, o: (i + n) % 3 === 0 };
});
const rings = [
  { r: 118, n: 3, dur: 36, dir: 1, dash: false, off: .4 },
  { r: 178, n: 5, dur: 54, dir: -1, dash: true, off: 1.1 },
  { r: 238, n: 6, dur: 80, dir: 1, dash: false, off: 0 },
];
---
<div class:list={['art', { flip }]} aria-hidden="true">
  <div class="halo"></div>
  <svg viewBox="0 0 520 520" focusable="false">
    {rings.map((g) => (
      <g class="spin" style={`--dur:${g.dur}s;--dir:${g.dir}`}>
        <circle cx="260" cy="260" r={g.r} fill="none" stroke="rgba(255,255,255,.16)" stroke-width="1.5" stroke-dasharray={g.dash ? '3 9' : undefined} />
        {nodes(g.r, g.n, g.off).map((p) => <circle cx={p.x} cy={p.y} r={p.o ? 7 : 5} fill={p.o ? '#FF7A1A' : '#F5F6F8'} />)}
      </g>
    ))}
  </svg>
  <img class="core" src="/images/ccas-tech-mark-reversed.svg" alt="" width="150" height="150" />
  <span class="ping"></span>
  {chips.slice(0, 4).map((c, i) => <span class="chip" style={`${Object.entries(pos[i]).map(([k, v]) => `${k}:${v}`).join(';')};animation-delay:${i * 0.9}s`}><i></i>{c}</span>)}
</div>

<style>
  .art { position: relative; width: 100%; max-width: 560px; aspect-ratio: 1; margin-inline: auto; display: none; }
  @media (min-width: 960px) { .art { display: block; } }
  .halo { position: absolute; inset: 14%; border-radius: 50%; background: radial-gradient(circle, rgba(255,122,26,.22), transparent 66%); animation: breathe 5s ease-in-out infinite; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .spin { transform-box: view-box; transform-origin: 50% 50%; animation: spin var(--dur) linear infinite; animation-direction: normal; }
  .flip .spin { animation-direction: reverse; }
  .spin[style*="--dir:-1"] { animation-direction: reverse; }
  .flip .spin[style*="--dir:-1"] { animation-direction: normal; }
  .core { position: absolute; left: 50%; top: 50%; width: 27%; height: auto; transform: translate(-50%, -50%); animation: breathe 6s ease-in-out infinite; filter: drop-shadow(0 12px 30px rgba(0,0,0,.35)); }
  .ping { position: absolute; left: 50%; top: 50%; width: 38%; aspect-ratio: 1; margin: -19% 0 0 -19%; border-radius: 50%; border: 1.5px solid rgba(255,122,26,.5); animation: pulse-ring 3.4s ease-out infinite; }
  .chip { position: absolute; display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 999px; background: rgba(19,41,77,.78); border: 1px solid var(--on-navy-line); backdrop-filter: blur(10px); color: #fff; font-size: 14px; font-weight: 600; white-space: nowrap; animation: floaty 5.5s ease-in-out infinite; }
  .chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgba(255,122,26,.2); }
  @media (prefers-reduced-motion: reduce) { .spin, .core, .halo, .ping, .chip { animation: none !important; } }
</style>

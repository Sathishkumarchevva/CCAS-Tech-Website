---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; }
const { title = 'Need the right expert for the right team?', text = 'Tell us the role and the timeline. A specialist will reply the same business day.' } = Astro.props;
---
<section class="section--navy cta-band dark" data-glow>
  <canvas class="stars" data-stars aria-hidden="true"></canvas>
  <div class="aurora" aria-hidden="true"><i></i><i></i></div>
  <div class="wrap inner">
    <div>
      <h2 data-split>{title}</h2>
      <p class="lede reveal" style="--d:.2s">{text}</p>
    </div>
    <div class="actions reveal" style="--d:.3s" data-r="scale">
      <a class="btn btn--primary" href="/contact/">Find a consultant <Icon name="ArrowRight" size={20} /></a>
      <a class="btn btn--outline" href="/consultants/">Join our network</a>
    </div>
  </div>
</section>
<style>
  .cta-band { position: relative; overflow: hidden; padding-block: clamp(72px, 9vw, 128px); isolation: isolate; }
  .stars { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .inner { display: grid; gap: 40px; align-items: center; }
  h2 { font-size: clamp(32px, 4.6vw, 60px); line-height: 1.08; letter-spacing: -0.025em; max-width: 16ch; }
  .lede { margin-top: 20px; max-width: 520px; }
  .actions { display: flex; flex-wrap: wrap; gap: 16px; }
  @media (min-width: 900px) { .inner { grid-template-columns: 1.4fr 1fr; } .actions { justify-content: flex-end; } }
</style>

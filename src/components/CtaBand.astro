---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; }
const { title = 'Need the right expert for the right team?', text = 'Tell us the role and the timeline. A specialist will reply the same business day.' } = Astro.props;
---
<section class="cta-band">
  <span class="ring r1" aria-hidden="true"></span><span class="ring r2" aria-hidden="true"></span>
  <div class="wrap inner">
    <div>
      <h2 data-split>{title}</h2>
      <p class="lede reveal" style="--d:.2s">{text}</p>
    </div>
    <div class="actions reveal" style="--d:.3s" data-r="scale">
      <a class="btn btn--secondary" href="/contact/">Find a consultant <Icon name="ArrowRight" size={20} /></a>
      <a class="btn btn--outline" href="/consultants/">Join our network</a>
    </div>
  </div>
</section>
<style>
  /* Sunset Orange band: breaks up runs of navy sections; Navy on Orange is 6.3:1 (AA) */
  .cta-band { position: relative; overflow: hidden; isolation: isolate; background: var(--orange); color: var(--navy); padding-block: clamp(64px, 8vw, 112px); }
  .ring { position: absolute; z-index: -1; border-radius: 50%; border: 1.5px solid rgba(11,31,58,.16); pointer-events: none; }
  .r1 { width: 720px; aspect-ratio: 1; right: -180px; top: 50%; transform: translateY(-50%); }
  .r2 { width: 460px; aspect-ratio: 1; right: -60px; top: 50%; transform: translateY(-50%); border-style: dashed; }
  .inner { display: grid; gap: 36px; align-items: center; }
  h2 { color: var(--navy); font-size: clamp(32px, 4.4vw, 56px); line-height: 1.08; letter-spacing: -0.025em; max-width: 16ch; }
  .lede { margin-top: 20px; max-width: 520px; color: var(--navy); }
  .actions { display: flex; flex-wrap: wrap; gap: 16px; }
  .actions :global(.btn--outline) { border-color: var(--navy); color: var(--navy); }
  .actions :global(.btn--outline:hover) { background: rgba(11,31,58,.1); }
  @media (min-width: 900px) { .inner { grid-template-columns: 1.4fr 1fr; } .actions { justify-content: flex-end; } }
</style>

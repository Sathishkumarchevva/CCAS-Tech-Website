---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="CCAS Tech — home"><Logo variant="reversed" /></a>
    <nav class="primary" aria-label="Primary">
      <ul role="list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary btn--sm cta" href="/contact/">Hire talent</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
      <span class="sr-only">Menu</span>
      <span class="ico-open"><Icon name="Menu" /></span>
      <span class="ico-close"><Icon name="X" /></span>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile" aria-label="Mobile" data-mobile-nav hidden>
    <ul role="list">
      {nav.map((n) => (
        <li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
    </ul>
    <a class="btn btn--primary" href="/contact/">Hire talent</a>
  </nav>
  <div class="progress" aria-hidden="true" data-progress></div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--navy); border-bottom: 1px solid var(--on-navy-line); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; margin-right: auto; text-decoration: none; }
  .primary ul { display: none; gap: 8px; padding: 0; }
  .primary a { position: relative; display: block; padding: 10px 16px; border-radius: 10px; color: var(--on-navy); text-decoration: none; font-weight: 500; transition: color .15s, background-color .15s; }
  .primary a::after { content: ""; position: absolute; left: 16px; right: 16px; bottom: 4px; height: 2px; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform .3s cubic-bezier(.2,.8,.2,1); }
  .primary a:hover::after { transform: scaleX(1); }
  .primary a:hover { color: #fff; }
  .primary a[aria-current="page"] { color: #fff; }
  .primary a[aria-current="page"]::after { transform: scaleX(1); }
  .cta { display: none; }
  .menu-btn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--on-navy-line); background: transparent; color: #fff; cursor: pointer; }
  .menu-btn .ico-close { display: none; }
  .menu-btn[aria-expanded="true"] .ico-open { display: none; }
  .menu-btn[aria-expanded="true"] .ico-close { display: block; }
  .mobile { border-top: 1px solid var(--on-navy-line); padding: 16px var(--gutter) 24px; display: grid; gap: 16px; background: var(--navy); }
  .mobile[hidden] { display: none; }
  .mobile ul { padding: 0; display: grid; }
  .mobile li a { display: block; padding: 14px 4px; color: #fff; font-family: var(--font-display); font-size: 22px; font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--on-navy-line); }
  .mobile li a[aria-current="page"] { color: var(--orange); }
  @media (min-width: 900px) {
    .primary ul { display: flex; }
    .cta { display: inline-flex; }
    .menu-btn, .mobile { display: none !important; }
    .bar { gap: 40px; }
    .brand { margin-right: 0; }
    .primary { margin-right: auto; }
  }
</style>

---
import { icons } from '@lucide/astro';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 24, class: cls } = Astro.props;
const C = (icons as Record<string, any>)[name];
if (!C) throw new Error(`Unknown Lucide icon: ${name}`);
---
<C size={size} stroke-width={2} aria-hidden="true" focusable="false" class={cls} />

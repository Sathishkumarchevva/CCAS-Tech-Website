# --- Form submissions -> Microsoft Excel via Power Automate -------------------------------------------
# Setup guide: docs/form-to-excel-power-automate.md
#
# Server-side only. Do NOT prefix with PUBLIC_ (it contains a secret signature).
# Set these in Vercel -> Settings -> Environment Variables (or here, for `npx vercel dev`).
POWER_AUTOMATE_URL=
# Time zone for the "Submitted (local)" column (IANA name). Default: America/New_York
FORM_TIMEZONE=

# Optional: send the forms to a different JSON endpoint instead (e.g. Formspree). Leave empty normally.
PUBLIC_FORM_ENDPOINT=

# --- Form submissions ---------------------------------------------------------------------------------
# Setup guide: docs/form-submissions-setup.md
# Server-side only. Do NOT prefix with PUBLIC_ (they are secrets).
# Set these in Vercel -> Settings -> Environment Variables (or here, for `npx vercel dev`).
# You need at least ONE of the first two; both is best.

# 1) Email every enquiry to HR (Resend, free). Sign up at resend.com with hr@ccas-tech.com.
RESEND_API_KEY=
# Optional: who receives the email (default hr@ccas-tech.com)
HR_EMAIL=
# Optional: sender once ccas-tech.com is verified in Resend, e.g. CCAS Tech Website <forms@ccas-tech.com>
RESEND_FROM=

# 2) Add every enquiry as a row in an Excel table (Power Automate flow, needs Premium)
POWER_AUTOMATE_URL=

# Time zone for the 'Received' time (IANA name). Default: America/New_York
FORM_TIMEZONE=

# Advanced: send the forms to some other JSON endpoint instead (e.g. Formspree). Leave empty normally.
PUBLIC_FORM_ENDPOINT=
